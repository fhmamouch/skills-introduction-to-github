    "install:app": "forge install --non-interactive -e development"
  },
  "dependencies": {
    "@forge/api": "^5.0.0",
    "@forge/react": "^10.0.0",
    "@forge/resolver": "^1.6.0",
    "@forge/bridge": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "license": "MIT"
}
